#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define NUM_L 3

&scroll_runtime_input_processor {
    active-layers = <BIT(NUM_L)>;
};

&lt {
    tapping-term-ms = <140>;
};

/ {
    behaviors {
        rot_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

            // ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
            // |        /       |       ,       |       .       |      -        |      ;       |    ESC         |                   |           |       L      |       R       |       D       |       Y       |      P      |
            // |        A       |       O       |       E       |      I        |      U       |    SCROLLLOCK  |                   |           |       G      |       N       |       T       |       S       |      K      |
            // |        X       |       C       |       V       |      W        |      Q       |    TAB         |                   |     F     |       J      |       H       |       M       |       B       |      Z      |
            // |    L_SHIFT     |               |               |   LOWER / Jp  |    Space     |    LEFT_WIN    |                   |  R_SHIFT  |      ENTER   |  Num_L / Ja   |               |               |   FUN_L     |
            // ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
        default_layer {
            bindings = <
                &kp FSLH     &kp COMMA    &kp DOT      &kp MINUS    &kp SEMI     &kp ESC                            &kp L        &kp R        &kp D        &kp Y        &kp P
                &kp A        &kp O        &kp E        &kp I        &kp U        &kp SCROLLLOCK                     &kp G        &kp N        &kp T        &kp S        &kp K
                &kp X        &kp C        &kp V        &kp W        &kp F        &kp TAB                            &kp J        &kp H        &kp M        &kp B        &kp Z
                &kp LSHIFT                             &kp LEFT_WIN &lt 1 LANGUAGE_1 &kp SPACE             &kp Q    &kp RSHIFT   &kp ENTER    &lt 3 LANGUAGE_2          &kp RCTRL
            >;
            sensor-bindings = <&rot_kp PG_DN PG_UP>;
        };
            // ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
            // |    /           |       <       |       >       |       _       |      ”        |    PAUSE_BREAK|                  |            |      （       |       ）     |        ↑      |        [      |    ]        |
            // |    LC(A)       |       LC(S)   |       END     |       LS(F)   |       U       |    SCROLLLOCK |                  |            |   Backspace   |       ←      |        ↓      |        →      |    DEL      |
            // |    UNDERSCORE  |       CUT     |       COPY    |       PASTE   |       LALT    |    TAB        |                  |   PSCRN    |    ' / "      |    = / +     |    \ / |      |    ` / ~      |    PIPE     |
            // |    L_SHIFT     |               |               |       LALT    |       none    |    SPACE      |                  |   RSHIFT   |   ENTER       |    LOWER2    |               |               |    RCTRL    |
            // ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
        Lower_layer {
            bindings = <
                &kp LS(FSLH)    &kp LS(COMMA)   &kp LS(DOT)     &kp LS(MINUS)   &kp DOUBLE_QUOTES   &kp PAUSE_BREAK                 &kp LPAR          &kp RPAR      &kp UP       &kp LBKT     &kp RBKT
                &kp LC(A)       &kp LC(S)       &kp END         &kp LC(F)       &none               &kp SCROLLLOCK                  &kp BSPC          &kp LEFT      &kp DOWN     &kp RIGHT    &kp DEL
                &kp LC(Z)       &kp LC(X)       &kp LC(C)       &kp LC(V)       &kp LALT            &kp TAB                         &kp APOS          &kp EQUAL     &kp BSLH     &kp GRAVE    &kp PIPE
                &kp LSHIFT                                      &kp LALT        &none               &kp SPACE           &kp PSCRN   &kp RSHIFT        &kp ENTER     &mo 2                     &kp RCTRL
            >;  
        };
            // -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
            // |    /           |       ,        |       END     |       {       |       ’      |    ESC        |                  |            |      L      |      R         |    PG_UP      |     {       |      }      |
            // |    HOME        |       C_SAVE   |       END     |       }       |       U      |    LCTRL      |                  |            |  Backspace  |    HOME        |    PG_DN      |    END      |    DEL      |
            // |    UNDO        |       CUT      |       COPY    |       PASTE   |       Q      |    TAB        |                  |      F     |    ' / "    |    = / +       |    \ / |      |    ` / ~    |    INS      |
            // |    L_SHIFT     |                |               |       BT_L    |      SPACE   |    LALT       |                  |   ENTER    |    none     |   R_SHIFT      |               |             |   R_SHIFT   |
            // -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
        Lower2_layer {
            bindings = <
                &none        &kp COMMA    &kp END      &kp LEFT_BRACE    &kp SINGLE_QUOTE    &kp ESC                             &kp L           &kp R        &kp PG_UP       &kp LBKT       &kp RBRC
                &kp HOME     &kp LS(S)    &kp END      &kp RIGHT_BRACE   &kp U               &kp LCTRL                           &kp BSPC        &kp HOME     &kp PG_DN       &kp END        &kp DEL
                &kp LC(Z)    &kp LC(X)    &kp LC(C)    &kp LC(V)         &kp Q               &kp TAB                             &kp APOS        &kp EQUAL    &kp BSLH        &kp GRAVE      &kp INS
                &kp LSHIFT                             &kp LALT          &none               &kp SPACE               &kp PSCRN   &kp RSHIFT      &kp ENTER    &none                          &kp RSHIFT
            >;
        };
            // --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
            // |        1       |      2        |       3       |       4       |       5       |    ESC        |               |            |      6       |      7        |       8       |       9       |       0       |
            // |        !       |      @        |       #       |       $       |       %       |    none       |               |            |      ^       |      &        |       *       |       (       |       )       | 
            // |        F1      |     F2        |     F3        |       F4      |       F5      |    TAB        |               |     ~      |    ' / "     |    = / +      |    \ / |      |    ` / ~      |       INS     |
            // |    L_SHIFT     |               |               | En / FUNC_L   |    Space      |    LSIHT      |               |   R_SHIFT  |      ENTER   |     none      |               |               |       R_SHIFT |
            // --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
        Num_layer {
            bindings = <
                &kp N1       &kp N2       &kp N3       &kp N4       &kp N5      &kp ESC                         &kp N6       &kp N7      &kp N8     &kp N9      &kp N0
                &kp LS(N1)   &kp LS(N2)   &kp LS(N3)   &kp LS(N4)   &kp LS(N5)  &studio_unlock                  &kp RS(N6)   &kp RS(N7)  &kp RS(N8) &kp RS(N9)  &kp RS(N0)
                &kp PLUS     &kp UNDER    &kp QMARK    &kp COLON    &kp DQT     &kp TAB                         &kp APOS     &kp EQUAL   &kp BSLH   &kp GRAVE   &kp PIPE
                &kp LSHIFT                             &kp LALT     &mo 4       &kp SPACE            &kp TILDE  &kp RSHIFT   &kp ENTER   &none                  &kp RCTRL
            >;
        };
            // ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
            // |     F1      |     F2     |     F3     |     F4     |    F5      |    none    |                |            |    F6      |    F7      |    F8      |    F9       |     F10     |
            // |     F11     |     F12    |     F13    |     F14    |    F15     |    none    |                |   none     |    F16     |    F17     |    F18     |    F19      |     F20     |
            // |     none    |    none    |    none    |    none    |   none     |    none    |                |   none     |    none    |    none    |    none    |    none     |     none    |
            // |     L_SHIFT |    none    |    none    |    none    |   none     |    none    |                |   none     |    none    |    none    |    none    |    none     |   To_BT_L   |
            // ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
        Func_layer {
            bindings = <
                &kp F1       &kp F2       &kp F3       &kp F4        &kp F5      &none                        &kp F6       &kp F7       &kp F8     &kp F9      &kp F10
                &kp F11      &kp F12      &kp F13      &kp F14       &kp F15     &none                        &kp F16      &kp F17      &kp F18    &kp F19     &kp F20
                &none        &none        &none        &none         &none       &none                        &none        &none        &none      &none       &none
                &mo 6                                  &kp LSHIFT    &none       &none             &none      &none        &none        &none                  &mo 5
            >;
        };
            // --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
            // |  BT_SEL 0  |  BT_SEL 1  |  BT_SEL 2  |  BT_SEL 3  |            |            |                  |            |    none    |    none    |    none    |   BT_CLR   | BT_CLR_ALL |
            // |    none    |    none    |    none    |    none    |   none     |    none    |                  |    none    |    none    |   BT_PRV   |    none    |   BT_NXT   |    none    |
            // |    none    |    none    |    none    |    none    |   none     |    none    |                  |    none    |    none    |    none    |    none    |   none     |    none    |
            // |    none    |            |            |    none    |   none     |    none    |                  |    none    |    none    |    none    |            |            |    none    |
            // --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
        Bt_layer {
            bindings = <
                &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3  &bt BT_SEL 4 &bt BT_SEL 5                  &none        &none        &none        &bt BT_CLR   &bt BT_CLR_ALL
                &none        &none        &none        &none         &none        &none                         &none        &bt BT_PRV   &none        &bt BT_NXT   &none
                &none        &none        &none        &none         &none        &none                         &none        &none        &none        &none        &none
                &none                                  &none         &none        &none             &none       &none        &none        &none                     &none
            >;
        };
            // --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
            // |    none    |    none    |    none    |    none    |   none     |    ESC     |                  |            |  ASTERISK  |      7     |     8      |     9      |      -     |
            // |    none    |    none    |    none    |    （      |     ）     |    none    |                  |            |    none    |      4     |     5      |     6      |      +     |
            // |    none    |    none    |    none    |    none    |   none     |    none    |                  |    CLEAR   |    none    |      1     |     2      |     3      |      /     |
            // |    L_SHIFT |            |            |    none    |   none     |    none    |                  |    none    |    ENTER   |      0     |            |            |    RCTRL   |
            // --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
        Tenkey_layer {
            bindings = <
                &none       &none        &none        &none         &none        &kp ESC                       &kp ASTERISK   &kp N7       &kp N8       &kp N9       &kp MINUS
                &none       &none        &none        &kp LPAR      &kp RPAR     &none                         &none          &kp N4       &kp N5       &kp N6       &kp PLUS
                &none       &none        &none        &none         &none        &none                         &kp N0         &kp N1       &kp N2       &kp N3       &kp SLASH
                &none                                 &kp LCTRL     &none        &none             &kp CLEAR   &none          &kp ENTER    &none                     &kp RCTRL
            >;
        };
            // --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
            // |    none    |    none    |    none    |    none    |   none     |    ESC     |                  |            |    MCLK    |    none    |    none    |   none     |    none    |
            // |    none    |    none    |    none    |    none    |   none     |    none    |                  |            |    none    |    RCLK    |    MB4     |   MB5      |    none    |
            // |    none    |    none    |    none    |    none    |   none     |    none    |                  |    none    | C_PREVIOUS |   C_NEXT   |    none    |   none     |    none    |
            // |    L_SHIFT |            |            |    none    |   none     |    none    |                  |    LCLK    |    none    |    none    |            |            |    RCTRL   |
            // --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
        Mouse_layer {
            bindings = <
                &none       &none        &none        &none         &none        &kp ESC                       &mkp MCLK        &none        &none        &none        &none
                &none       &none        &none        &none         &none        &none                         &none            &mkp RCLK    &mkp MB4     &mkp MB5     &none
                &none       &none        &none        &none         &none        &none                         &kp C_PREVIOUS   &kp C_NEXT   &none        &none        &none
                &kp LSHIFT                            &kp LCTRL     &none        &none             &none       &mkp LCLK        &none        &none                     &kp RCTRL
            >;
        };
    };
};
